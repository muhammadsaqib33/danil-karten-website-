# Public canonical URL (no secrets here; safe for client/metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content visibility mode:
# - "preview": renders candidate treatments, demo gallery/before-after layouts,
#              and labeled placeholder portrait, while adding noindex/robots disallow.
# - "production": publishes owner-approved services and non-demo images only;
#                 excludes demo comparisons and never falls back to demo content.
CONTENT_MODE=production

# Consultation delivery mode:
# - "demo": explicit development/preview mode (validates without claiming CRM delivery)
# - "crm": forwards validated consultation requests to DaniCare CRM
# - "unavailable": disables online form submission and directs visitors to call
CONSULTATION_DELIVERY_MODE=demo

# Server-only DaniCare CRM integration (NEVER prefix with NEXT_PUBLIC_)
CRM_API_URL=
CRM_API_KEY=

# Legacy alias for local draft treatment inspection (prefer CONTENT_MODE=preview)
ENABLE_DRAFT_PREVIEW=false
